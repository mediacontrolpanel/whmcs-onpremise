{
  "name": "mediacontrolpanel/whmcs-onpremise",
  "description": "MediaCP provisioning module for WHMCS.",
  "type": "whmcs-module",
  "license": "proprietary",
  "require": {
    "php": ">=8.1 <8.6",
    "ext-curl": "*",
    "ext-xml": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
  },
  "scripts": {
    "lint": [
      "php -l modules/servers/mediacp/mediacp.php",
      "php -l modules/servers/mediacp/hooks.php",
      "php -l modules/servers/mediacp/IXR_Library.php"
    ],
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
